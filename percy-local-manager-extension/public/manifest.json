{
  "manifest_version": 3,
  "name": "Percy Local Manager",
  "version": "1.0.0",
  "description": "Capture browser state (DOM, URL, viewport) and send it to the local Percy Local Manager backend.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Percy Local Manager",
    "default_icon": "icons/percy-icon.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "http://localhost:4321/*"
  ],
  "icons": {
    "16": "icons/percy-icon.png",
    "48": "icons/percy-icon.png",
    "128": "icons/percy-icon.png"
  }
}