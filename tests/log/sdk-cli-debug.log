      lang: 'javascript',
      code: 'async ({\n' +
        '    request\n' +
        '  }) => {\n' +
        '    // Create two snapshots\n' +
        "    await request.post('/snapshots', {\n" +
        '      data: VALID_SNAPSHOT\n' +
        '    });\n' +
        "    await request.post('/snapshots', {\n" +
        '      data: {\n' +
        '        ...VALID_SNAPSHOT,\n' +
        "        name: 'Second Snapshot'\n" +
        '      }\n' +
        '    });\n' +
        "    const clearRes = await request.delete('/snapshots');\n" +
        '    expect(clearRes.status()).toBe(200);\n' +
        '    const body = await clearRes.json();\n' +
        "    expect(body.message).toBe('Snapshots cleared');\n" +
        '\n' +
        '    // Verify queue is empty\n' +
        "    const listRes = await request.get('/snapshots');\n" +
        '    const list = await listRes.json();\n' +
        '    expect(list.length).toBe(0);\n' +
        '  }'
    },
