      name: 'Popup: Library token panel is present (Connect Library or Change token)',
      body: {
        lang: 'javascript',
        code: 'async () => {\n' +
          "    await goTo('index.html');\n" +
          '    // LibraryTokenPanel renders either "Connect Library" or "Change token" after isChecking resolves\n' +
          "    const connectBtn = page.getByRole('button', {\n" +
          "      name: 'Connect Library'\n" +
          '    });\n' +
          "    const changeBtn = page.getByRole('button', {\n" +
          "      name: 'Change token'\n" +
          '    });\n' +
          '    await Promise.race([connectBtn.waitFor({\n' +
          "      state: 'visible',\n" +
          '      timeout: 5000\n' +
          '    }).catch(() => null), changeBtn.waitFor({\n' +
          "      state: 'visible',\n" +
          '      timeout: 5000\n' +
          '    }).catch(() => null)]);\n' +
          '    const panelPresent = (await connectBtn.isVisible().catch(() => false)) || (await changeBtn.isVisible().catch(() => false));\n' +
          "    expect(panelPresent, 'Library token panel should show Connect Library or Change token button').toBe(true);\n" +
          '  }'
      },
      identifier: 'Popup: Library token panel is present (Connect Library or Change token)',
