      lang: 'javascript',
      code: 'async ({\n' +
        '    request\n' +
        '  }) => {\n' +
        '    // Create a snapshot to update\n' +
        "    const createRes = await request.post('/snapshots', {\n" +
        '      data: VALID_SNAPSHOT\n' +
        '    });\n' +
        '    const {\n' +
        '      snapshot\n' +
        '    } = await createRes.json();\n' +
        '    const res = await request.patch(`/snapshots/${snapshot.id}`, {\n' +
        '      data: {\n' +
        "        name: 'Updated Name'\n" +
        '      }\n' +
        '    });\n' +
        '    expect(res.status()).toBe(200);\n' +
        '    const body = await res.json();\n' +
        "    expect(body.message).toBe('Snapshot updated');\n" +
        "    expect(body.snapshot.name).toBe('Updated Name');\n" +
        '    expect(body.snapshot.id).toBe(snapshot.id);\n' +
        '  }'
    },
