# Copy this file to tests/.env and fill in your values.
# tests/.env is gitignored — never commit real secrets.

# URL of the running Go backend (default: http://localhost:4321)
BACKEND_URL=http://localhost:4321

# Percy write token — required only for POST /build/finalize (Step 7 E2E test)
# Get it from: https://percy.io → your project → Settings → Token
PERCY_TOKEN=

# Percy read token — required only for POST /library/token (library tests)
# Get it from: https://percy.io → your project → Settings → Read Token
PERCY_READ_TOKEN=
